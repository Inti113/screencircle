{
  "name": "screencircle",
  "version": "1.0.0",
  "description": "Screen recorder with webcam overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "com.screencircle.app",
    "productName": "ScreenCircle",
    "files": [
      "**/*",
      "!**/node_modules/electron-builder/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "directories": {
      "output": "../dist"
    }
  }
}
